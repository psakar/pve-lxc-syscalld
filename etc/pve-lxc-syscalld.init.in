#!/bin/sh
### BEGIN INIT INFO
# Provides:          pve-lxc-syscalld
# Required-Start:    $local_fs $remote_fs $syslog
# Required-Stop:     $local_fs $remote_fs $syslog
# X-Start-Before:    pve-guests
# X-Stop-After:      pve-guests
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Proxmox VE LXC Syscall Daemon
### END INIT INFO

# LSB counterpart of pve-lxc-syscalld.service, only installed by the
# pkg.pve-lxc-syscalld.lsbservice build (see debian/rules). The daemon runs in
# the foreground, so it's backgrounded with a pid file here. Like the unit's
# Type=notify, starting only returns once it listens on its socket, and like
# its RuntimeDirectory=, /run/pve-lxc-syscalld is created on start and removed
# on stop.

. /lib/lsb/init-functions

NAME=pve-lxc-syscalld
DESC="Proxmox VE LXC Syscall Daemon"
DAEMON=%LIBEXECDIR%/pve-lxc-syscalld/pve-lxc-syscalld
RUNDIR=/run/pve-lxc-syscalld
SOCKET=$RUNDIR/socket
PIDFILE=/run/pve-lxc-syscalld.pid

test -x $DAEMON || exit 0

do_start() {
    install -d -m 0755 $RUNDIR
    start-stop-daemon --start --quiet --background --make-pidfile --pidfile $PIDFILE \
        --exec $DAEMON -- --system $SOCKET || return 1
    # wait for it to listen on its socket, i.e. to be ready (Type=notify)
    for i in $(seq 1 50); do
        [ -S $SOCKET ] && return 0
        start-stop-daemon --status --pidfile $PIDFILE || return 1
        sleep 0.1
    done
    return 1
}

do_stop() {
    start-stop-daemon --stop --quiet --oknodo --retry TERM/10/KILL/5 --pidfile $PIDFILE \
        --remove-pidfile --exec $DAEMON
    status=$?
    rm -rf $RUNDIR
    return $status
}

case "$1" in
    start)
        log_daemon_msg "Starting $DESC" "$NAME"
        if start-stop-daemon --status --pidfile $PIDFILE; then
            log_end_msg 0 # already running
            exit 0
        fi
        do_start
        log_end_msg $?
        ;;
    stop)
        log_daemon_msg "Stopping $DESC" "$NAME"
        do_stop
        log_end_msg $?
        ;;
    restart|force-reload)
        log_daemon_msg "Restarting $DESC" "$NAME"
        do_stop && do_start
        log_end_msg $?
        ;;
    status)
        status_of_proc -p $PIDFILE $DAEMON $NAME
        ;;
    *)
        echo "Usage: /etc/init.d/$NAME {start|stop|restart|force-reload|status}" >&2
        exit 3
        ;;
esac
